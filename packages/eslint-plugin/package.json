{
  "name": "@dialexjs/eslint-plugin",
  "version": "0.8.0",
  "description": "ESLint and oxlint rules for Dialex: unknown dictionaries and keys, dynamic keys, hard-coded text and dictionary file checks",
  "keywords": [
    "dialex",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "i18n",
    "oxlint"
  ],
  "homepage": "https://github.com/awaiden/dialex#readme",
  "bugs": {
    "url": "https://github.com/awaiden/dialex/issues"
  },
  "license": "MIT",
  "author": "awaiden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaiden/dialex.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@dialexjs/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
