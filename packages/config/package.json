{
  "name": "@dialexjs/config",
  "version": "0.9.0",
  "description": "Reads dialex.config.* and writes the static .dialex/config.json that the native CLI and language server run from",
  "homepage": "https://github.com/awaiden/dialex#readme",
  "bugs": {
    "url": "https://github.com/awaiden/dialex/issues"
  },
  "license": "MIT",
  "author": "awaiden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaiden/dialex.git"
  },
  "bin": {
    "dialex-config": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "dialexjs": "workspace:*",
    "magicast": "^0.5.5",
    "unconfig": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
