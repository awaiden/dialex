{
  "name": "example-adonis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "scripts": {
    "dev": "dx generate && node ace serve --hmr",
    "start": "node bin/server.js",
    "build": "dx generate && tsc --noEmit",
    "dx:generate": "dx generate",
    "lint": "oxlint"
  },
  "dependencies": {
    "@adonisjs/core": "^6.18.0",
    "dialexjs": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/tsconfig": "^1.4.0",
    "@dialexjs/cli": "workspace:*",
    "@swc/core": "1.11.24",
    "@types/node": "^22.15.18",
    "hot-hook": "^0.4.0",
    "oxlint": "^1.81.0",
    "pino-pretty": "^13.0.0",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.8"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
