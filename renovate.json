{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Peer ranges say which framework versions Dialex supports; widening or raising them is a manual decision",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "Group non-major updates into one weekly pull request",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Examples only demonstrate the library, keep their updates in one group",
      "matchFileNames": ["examples/**"],
      "groupName": "example dependencies"
    }
  ]
}
